{
  "name": "Autonomous Agent Swarm Research",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "text": "Generate a list of 100 diverse and advanced research topics in science, math, and technology (e.g. 'Quantum Computing', 'CRISPR', 'Dark Matter', 'Riemann Hypothesis'). Return them as a strict JSON array of strings: [\"topic1\", \"topic2\"]. Do not include any other text or markdown formatting.",
        "options": {}
      },
      "id": "agent_brainstorm",
      "name": "Brainstorm Agent",
      "type": "agent",
      "typeVersion": 1,
      "position": [200, 0]
    },
    {
      "parameters": {
        "model": "gpt-4"
      },
      "id": "llm_brainstorm",
      "name": "OpenAI Chat Model",
      "type": "lmChatOpenAi",
      "typeVersion": 1,
      "position": [200, 250]
    },
    {
      "parameters": {
        "jsCode": "const text = items[0].json.output;\nlet topics = [];\ntry {\n  const match = text.match(/\\[.*\\]/s);\n  if (match) {\n      topics = JSON.parse(match[0]);\n  }\n} catch(e) {}\nif (topics.length === 0) topics = [\"Failed to generate topics\"];\nreturn topics.map(t => ({ json: { topic: t } }));"
      },
      "id": "splitter",
      "name": "Split Topics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [400, 0]
    },
    {
      "parameters": {
        "text": "Research the topic: {{ $json.topic }}. \n1. Use Search to find relevant, high-quality websites.\n2. Use Web Crawler to explore those sites (you can set depth=1 to follow links).\n3. Synthesize the findings.",
        "options": {}
      },
      "id": "agent_research",
      "name": "Research Agent",
      "type": "agent",
      "typeVersion": 1,
      "position": [600, 0]
    },
    {
      "parameters": {
        "proxy": "socks5://localhost:9050",
        "maxPages": 10
      },
      "id": "crawler",
      "name": "Web Crawler",
      "type": "toolWebCrawler",
      "typeVersion": 1,
      "position": [600, 200]
    },
    {
      "parameters": {},
      "id": "serp",
      "name": "SerpAPI",
      "type": "toolSerpApi",
      "typeVersion": 1,
      "position": [600, 300]
    },
    {
      "parameters": {
        "jsCode": "const batchSize = 10;\nconst batches = [];\n// items is all inputs from previous node\nfor (let i = 0; i < items.length; i += batchSize) {\n    const batch = items.slice(i, i + batchSize);\n    const combined = batch.map(item => item.json.output).join('\\n---\\n');\n    batches.push({ json: { batch_content: combined, batch_id: (i/batchSize)+1 } });\n}\nreturn batches;"
      },
      "id": "group_10",
      "name": "Group into 10 Batches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [800, 0]
    },
    {
      "parameters": {
        "text": "Summarize these research findings into a comprehensive section.\n\nFindings:\n{{ $json.batch_content }}",
        "options": {}
      },
      "id": "agent_section",
      "name": "Section Compiler",
      "type": "agent",
      "typeVersion": 1,
      "position": [1000, 0]
    },
    {
      "parameters": {
        "jsCode": "const sections = items.map(item => item.json.output).join('\\n\\n');\nreturn [{ json: { full_content: sections } }];"
      },
      "id": "agg_final",
      "name": "Aggregate Sections",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [1200, 0]
    },
    {
      "parameters": {
        "text": "Compile the final 5-25 page report from these sections. Ensure full citations.",
        "options": {}
      },
      "id": "agent_final",
      "name": "Final Compiler",
      "type": "agent",
      "typeVersion": 1,
      "position": [1400, 0]
    }
  ],
