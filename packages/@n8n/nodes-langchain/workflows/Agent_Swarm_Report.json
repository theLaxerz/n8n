            "index": 0
          },
          {
            "node": "Final Compiler",
            "type": "ai_language_model",
            "index": 0
          }
        ]
      ]
    },
    "Research Agent": {
      "main": [
        [
          {
            "node": "Group into 10 Batches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Group into 10 Batches": {
